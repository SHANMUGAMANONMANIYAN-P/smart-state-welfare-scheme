# ============================================================================
# Smart Welfare Scheme Eligibility Prediction Engine
# Environment Configuration (.env)
# ============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Secret for Session Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars

# MySQL Database Configuration
# The application connects to MySQL 8.0+.
# If MySQL is not running or credentials are not supplied,
# the backend gracefully falls back to local storage so services remain testable.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=welfare_schemes_db

# Initial Administrator Provisioning (Used by server/src/scripts/createAdmin.js)
ADMIN_EMAIL=shanmugamanonmaniyan@gmail.com
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_password

# Google OAuth 2.0 Authentication (Google Cloud Console credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
SESSION_SECRET=smart_welfare_session_secret_key_2026
ADMIN_GOOGLE_SUBJECT=
